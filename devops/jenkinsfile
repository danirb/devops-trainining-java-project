#!groovy

pipeline {
  agent any
  stages {
    stage('Info') {
      steps {
        sh "echo Job: ${env.JOB_NAME}"
        sh "echo Build: ${env.BUILD_NUMBER}"
      }
    }

    stage('Test') {
      agent {
        docker {
         image 'maven:3.8.6-openjdk-11-slim'
        }
      }
      steps {
        sh 'mvn install'
        sh 'mvn test'
      }
    }
  }


}
