#!groovy

pipeline {
  agent any

  environment {
    DOCKERHUB_CREDENTIALS = credentials('dockerhub')
    SONARQUBE_TOKEN = credentials('sonarqube-token')
    TAG_NAME = '1.0.4-SNAPSHOT'
    SONARQUBE_HOST_LOCAL = "${env.SONARQUBE_HOST}"
    DOCKER_IMAGE = 'scalian_training/java-app'
    DOCKER_REGISTRY_IMAGE = 'adrianscalian/scalian_training_java-app'
    MAVEN_IMAGE = 'maven:3.8.6-openjdk-11-slim'
  }

  stages {
    stage('List env vars') {
      steps {
        sh 'printenv | sort'
      }
    }

    stage('Info') {
      steps {
        sh 'echo Job: ${env.JOB_NAME}'
        sh 'echo Job: ${env.BUILD_NUMBER}'
      }
    }

    stage('Test') {
      agent {
        docker {
          image "${env.MAVEN_IMAGE}"
        }
      }
      steps {
        sh 'mvn test'
      }
    }

    stage('SonarQube') {
      agent {
        docker {
          image "${env.MAVEN_IMAGE}"
        }
      }
      steps {
        sh """
          mvn verify sonar:sonar \
            -Dsonar.projectKey=java-example-jenkins \
            -Dsonar.host.url="${SONARQUBE_HOST_LOCAL}" \
            -Dsonar.login="${SONARQUBE_TOKEN}"
        """
      }
    }

    stage('Maven Install') {
      agent {
        docker {
          image "${env.MAVEN_IMAGE}"
        }
      }
      steps {
        sh 'mvn clean install -DskipTests'
      }
    }

    stage('Docker Build') {
      steps {
        sh 'ls $WORKSPACE/target/'
        sh """
          docker build -t ${DOCKER_IMAGE} \
            -f devops/Dockerfile \
            --build-arg VERSION=${TAG_NAME} \
            .
        """
      }
    }

    stage('Docker Push') {
      steps {
        sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
        sh "docker tag ${DOCKER_IMAGE} ${DOCKER_REGISTRY_IMAGE}:${TAG_NAME}"
        sh "docker push ${DOCKER_REGISTRY_IMAGE}:${TAG_NAME}"
      }
    }
  }

  post {
    always {
      sh 'docker logout'
    }
    success {
      echo 'SUCCESS'
      archiveArtifacts artifacts: 'target/*.jar'
    }
  }
}
